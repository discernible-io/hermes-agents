# Hermes agents deploy wrapper — code only. Runtime config/state live in ../hermes-agents-app/.

# --- Secrets / local env (never commit) ---
env.local
.env
.env.*
!.env.example

# Tenant persona seeds — live under ~/hermes-agents-app/seed/ only.
# Keep a publishable stub README.md here; ignore any accidental local dumps.
seed/**
!seed/README.md

# --- Accidental runtime state inside the checkout (normally in HERMES_APP_DIR) ---
**/secrets/
**/sessions/
**/memories/
**/logs/
**/sandboxes/
**/pairing/
**/certs/
**/bin/
config.yaml
config.yaml.bak*
auth.json
gateway_state.json
gateway.lock
gateway.pid
webhook_subscriptions.json
state.db
state.db-*
*.db-wal
*.db-shm
kanban.db*
feishu_comment_rules.json
feishu_comment_pairing.json

# Rendered nginx sidecar config (source templates live in nginx/inc/)
nginx/nginx.conf

# --- Node (idcp deps — run ./hermes.sh idcp-install per host) ---
idcp/node_modules/
idcp/vendor/hola-client/node_modules/

# --- Logs & scratch ---
*.log
tmp/
.temp/
.cache/

# --- OS / editors ---
.DS_Store
Thumbs.db
.cursor/
.vscode/
*.swp
*~
