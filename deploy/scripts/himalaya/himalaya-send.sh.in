#!/bin/sh
# Headless outbound mail via Himalaya (no $EDITOR).
# Usage: sh scripts/himalaya-send.sh [-a ACCOUNT] [-b BCC]... TO SUBJECT [BODY]
set -eu
ACCOUNT="__DEFAULT_ACCOUNT__"
BCC=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    -a|--account)
      ACCOUNT="${2:?}"
      shift 2
      ;;
    -b|--bcc)
      if [ -n "$BCC" ]; then
        BCC="${BCC}, ${2:?}"
      else
        BCC="${2:?}"
      fi
      shift 2
      ;;
    *)
      break
      ;;
  esac
done
TO="${1:?usage: himalaya-send.sh [-a ACCOUNT] [-b BCC]... TO SUBJECT [BODY]}"
SUBJECT="${2:?usage: himalaya-send.sh [-a ACCOUNT] [-b BCC]... TO SUBJECT [BODY]}"
BODY="${3:-}"

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
LOOKUP="${SCRIPT_DIR}/himalaya-accounts.tsv"
EMAIL=""
DISPLAY_NAME=""
if [ -f "$LOOKUP" ]; then
  # shellcheck disable=SC2034
  while IFS='|' read -r name email display; do
    case "$name" in
      \#*|"") continue ;;
    esac
    if [ "$name" = "$ACCOUNT" ]; then
      EMAIL="$email"
      DISPLAY_NAME="$display"
      break
    fi
  done <"$LOOKUP"
fi
if [ -z "$EMAIL" ]; then
  echo "ERROR: unknown account '${ACCOUNT}' (see scripts/himalaya-accounts.tsv)" >&2
  exit 1
fi

# Fail fast when SMTP is unreachable (stale --add-host pin, egress block, etc.).
# Without this, himalaya hangs until the tool/cron timeout (often 90s+).
# /dev/tcp is bash-only — probe via python (always present in hermes sandboxes).
SMTP_HOST="${HERMES_SMTP_HOST:-smtp.migadu.com}"
SMTP_PORT="${HERMES_SMTP_PORT:-587}"
SMTP_PROBE_SECS="${HERMES_SMTP_PROBE_SECS:-8}"
if ! python3 - "$SMTP_HOST" "$SMTP_PORT" "$SMTP_PROBE_SECS" <<'PY'
import socket, sys
host, port, secs = sys.argv[1], int(sys.argv[2]), float(sys.argv[3])
try:
    with socket.create_connection((host, port), timeout=secs):
        pass
except OSError as e:
    print(f"ERROR: cannot reach {host}:{port} within {secs:.0f}s ({e})", file=sys.stderr)
    sys.exit(75)
PY
then
  echo "Likely causes: stale sandbox --add-host pin, IPv6-only resolve with no v6 route," >&2
  echo "or egress firewall. Check: getent hosts ${SMTP_HOST}; docker inspect ExtraHosts." >&2
  echo "Fix: update terminal.docker_extra_args SMTP pin, then recreate hermes-* sandboxes." >&2
  exit 75
fi

{
  printf 'From: %s <%s>\n' "$DISPLAY_NAME" "$EMAIL"
  printf 'To: %s\n' "$TO"
  if [ -n "$BCC" ]; then
    printf 'Bcc: %s\n' "$BCC"
  fi
  printf 'Subject: %s\n' "$SUBJECT"
  printf '\n%s\n' "$BODY"
} | himalaya message send -a "$ACCOUNT"
