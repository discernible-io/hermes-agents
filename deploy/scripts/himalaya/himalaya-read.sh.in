#!/bin/sh
# Read full message (headers + body).
# Usage: sh scripts/himalaya-read.sh [-a ACCOUNT] <ID>
set -eu
ACCOUNT="__DEFAULT_ACCOUNT__"
while [ "$#" -gt 0 ]; do
  case "$1" in
    -a|--account)
      ACCOUNT="${2:?}"
      shift 2
      ;;
    *)
      break
      ;;
  esac
done
ID="${1:?usage: himalaya-read.sh [-a ACCOUNT] <ID>}"
himalaya message read -a "$ACCOUNT" "$ID" --output plain
